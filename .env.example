# Copy to .env (never committed). All optional: without Redis, reactions are counted locally in the browser.

# Reactions store (/api/react). Upstash Redis REST credentials — either pair works.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI twin (milestone 5). Server-side only.
ANTHROPIC_API_KEY=
