# Copy to .env (never committed). All optional: without Redis, reactions are counted locally in the browser.

# Reactions store (/api/react). Upstash Redis REST credentials — either pair works.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (Harnie + Career Coach). Server-side only.
ANTHROPIC_API_KEY=

# Career Coach: global daily AI spend cap in USD (kill switch), counted from real token usage per UTC day.
CAREER_DAILY_BUDGET_USD=1

# Career Coach: Cloudflare Turnstile (free) for device registration. Both are read at request time (no rebuild).
# Without the secret, registration skips the check (local dev).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Job ingest (GitHub Actions, scripts/ingest-jobs.ts): optional free Himalayas key for higher limits.
# The workflow also needs UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN as GitHub Actions secrets.
HIMALAYAS_API_KEY=

# Live job search when nothing in the pool fits (Vercel only). Free keys: developer.adzuna.com and jooble.org/api/about.
# Only the visitor's target role, level and place are sent. Leave empty to turn live search off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Which live search sources to use, comma-separated: "adzuna,jooble", "jooble", or empty for none. Unset = all with keys.
JOB_SEARCH_SOURCES=

# Optional: canonical origin if the domain isn't https://theiconiciyanuoluwa.com (canonical URLs, OG, sitemap).
SITE_URL=

CARD_SECRET
