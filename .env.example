# Copy to .env (never committed). All optional: without Redis, reactions are counted locally in the browser.

# Reactions store (/api/react). Upstash Redis REST credentials — either pair works.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (Harnie + Career Coach). Server-side only.
ANTHROPIC_API_KEY=

# Career Coach: global daily AI spend cap in USD (kill switch).
CAREER_DAILY_BUDGET_USD=1

# Career Coach: Cloudflare Turnstile (free) for device registration.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Job ingest (GitHub Actions, scripts/ingest-jobs.ts): optional free Himalayas key for higher limits.
# The workflow also needs UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN as GitHub Actions secrets.
HIMALAYAS_API_KEY=
