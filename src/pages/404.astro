---
import Base from '../layouts/Base.astro';
import ClayObject from '../components/ClayObject.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import resume from '../content/resume.json';

const { identity } = resume;
---

<Base title={`Page not found — ${identity.name}`} description="This page missed its landing pad." noindex>
  <Header brand={identity.name.split(' ')[0]} home={false} />
  <main id="main" tabindex="-1" class="container lost">
    <div id="top" class="lost__scene" aria-hidden="true">
      <span class="lost__pad"></span>
      <span class="lost__orb"><ClayObject tone="lilac" shade="min(72px, 12svh)" /></span>
      <span class="lost__dust"></span>
      <span class="lost__dust lost__dust--2"></span>
    </div>
    <p class="label">404 · Off the map</p>
    <h1 class="lost__title">This page missed its landing pad.</h1>
    <p class="lost__lead">The link may be old, or the page moved. Everything worth seeing is back on the main page.</p>
    <div class="lost__actions">
      <a class="btn btn--lg btn--primary" href="/">Back to the portfolio</a>
      <a class="btn btn--lg btn--secondary" href="/resume/">Read the résumé</a>
    </div>
  </main>
  <Footer name={identity.name} email={identity.email} linkedin={identity.linkedin} instagram={identity.instagram} />
</Base>

<style>
  main:focus { outline: none; }
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    padding-block: clamp(var(--s-6), 7svh, var(--s-14)) var(--s-24);
    text-align: center;
  }
  /* The scene scales with the viewport's height too, so the headline stays above the fold in landscape. */
  .lost__scene {
    position: relative;
    width: min(320px, 80vw, 54svh);
    aspect-ratio: 32 / 22;
    margin-bottom: var(--s-2);
  }
  /* The pad is where the orb should have landed; the orb ended up beside it, tipped over. */
  .lost__pad {
    position: absolute;
    left: 12.5%;
    bottom: 4.5%;
    width: 44%;
    height: 10%;
    border-radius: 50%;
    background: var(--clay-drop);
  }
  .lost__orb {
    position: absolute;
    right: 6%;
    bottom: 6%;
    width: 37.5%;
    aspect-ratio: 1;
    rotate: 24deg;
  }
  .lost__dust {
    position: absolute;
    right: 44%;
    bottom: 5%;
    width: 5.6%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-alt);
  }
  .lost__dust--2 { right: 3%; bottom: 3.6%; width: 3.8%; }
  .lost__title {
    max-width: 14em;
    font-size: var(--fs-h2);
    line-height: 1;
  }
  .lost__lead {
    max-width: 520px;
    font-size: var(--fs-lead);
    color: var(--ink-muted);
  }
  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lost__orb { animation: overshoot 1.1s var(--ease-out) 0.2s both; }
    .lost__pad { animation: padWait 1.1s var(--ease-out) 0.2s both; }
    .lost__dust { animation: puff 0.6s var(--ease-out) 0.95s both; }
  }
  @keyframes overshoot {
    0% { opacity: 0; transform: translate(-260px, -220px) rotate(-200deg) scale(0.5); }
    55% { opacity: 1; transform: translate(-150px, 0) scale(1.15, 0.85); }
    70% { transform: translate(-60px, -40px) rotate(-10deg); }
    85% { transform: translate(-10px, 4px) scale(1.12, 0.88); }
    100% { transform: none; }
  }
  @keyframes padWait { 0%, 45% { transform: scaleX(0.4); opacity: 0; } 60% { transform: scaleX(1.1); opacity: 1; } 100% { transform: none; } }
  @keyframes puff { from { opacity: 0.9; transform: scale(0.4); } to { opacity: 0; transform: translateY(-14px) scale(1.6); } }
</style>
