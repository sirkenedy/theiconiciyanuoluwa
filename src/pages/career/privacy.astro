---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import owner from '../../content/owner.json';
import resume from '../../content/resume.json';
import { DAILY_LIMITS } from '../../lib/career/limits';
import { ogAltFor } from '../../lib/text';
import { searchConfigured } from '../../lib/jobs/search';

// Static: no visitor data is involved in rendering this page.
export const prerender = true;

const { name, firstName } = owner;
const { identity } = resume;
const SOURCES = [
  { name: 'Greenhouse', url: 'https://developers.greenhouse.io/job-board.html', note: 'public company job boards' },
  { name: 'Lever', url: 'https://github.com/lever/postings-api', note: 'public company job boards' },
  { name: 'Ashby', url: 'https://developers.ashbyhq.com/docs/public-job-posting-api', note: 'public company job boards' },
  { name: 'Himalayas', url: 'https://himalayas.app/api', note: 'remote jobs; apply links are passed through unchanged' },
  { name: 'Remotive', url: 'https://remotive.com/api-documentation', note: 'remote jobs, shown at least 24 hours after posting' },
  { name: 'Jobicy', url: 'https://jobi.cy/apidocs', note: 'remote jobs; "Open job" goes to the Jobicy page' },
];
// Live search sources are listed only when enabled and keyed (this page is built with the deployment's env).
const ADZUNA = searchConfigured('adzuna');
const JOOBLE = searchConfigured('jooble');
if (ADZUNA) SOURCES.push({ name: 'Adzuna', url: 'https://developer.adzuna.com/', note: 'live search by role and place; "Open job" goes to the Adzuna listing' });
if (JOOBLE) SOURCES.push({ name: 'Jooble', url: 'https://jooble.org/api/about', note: 'live search by role and place; "Open job" goes to the Jooble listing' });
const live = [ADZUNA && 'Adzuna', JOOBLE && 'Jooble'].filter(Boolean).join(' and ');
---

<Base title={`Ami (career coach) privacy — ${name}`} description="How Ami, the career coach, keeps your résumé and chats on your device, what is sent to the AI, which job sources it uses and how to delete everything." ogAlt={ogAltFor(identity)}>
  <Header brand={firstName} home={false} />
  <main id="main" tabindex="-1" class="container privacy">
    <p class="label">Ami, your career coach · Privacy</p>
    <h1 class="privacy__title">Your data stays with you.</h1>
    <p class="privacy__lead">Ami, the career coach on this site, is free and built to keep your résumé and conversations on your own device. Here is exactly what happens, in plain words.</p>

    <section aria-labelledby="p-device">
      <h2 id="p-device">What stays on your device</h2>
      <ul>
        <li>Your résumé, your profile, your chats, tailored résumés, cover letters and saved jobs are stored <strong>only in this browser</strong>, encrypted with a key that this site can use but cannot read out or copy.</li>
        <li>Nothing is stored in an account, because there are no accounts. If you open Ami on another device, it starts fresh.</li>
        <li>Anything you haven't touched for 90 days is deleted automatically.</li>
        <li>In a mock interview you can answer by speaking. Your voice is turned into text <strong>on this device</strong> by an open-source speech model (Whisper); the audio is <strong>never uploaded or saved</strong>. Only the text is sent to the AI, like a typed answer, along with simple timings measured on your device (how long you spoke, your pace, filler words) for your scorecard.</li>
      </ul>
    </section>

    <section aria-labelledby="p-ai">
      <h2 id="p-ai">What is sent to the AI</h2>
      <ul>
        <li>To answer you, the text it needs (your résumé or profile, a job description, your question) is sent to <a href="https://www.anthropic.com/legal/privacy" rel="noopener">Anthropic</a>'s Claude, a Haiku-class model. It is processed to write the answer; this site keeps no copy.</li>
        <li>Your <strong>email address and phone number are removed</strong> on your device before anything is sent. Downloaded résumés get them back from your own file, on your device.</li>
        <li>Your résumé file itself is read in your browser and never uploaded.</li>
        <li>Jobs are matched to the country you live in. It comes from your résumé; if your résumé doesn't say, Ami uses the country your network connects from (an estimate our host adds to each request). It is not stored.</li>
        {live && <li>When no saved job fits, Ami searches job sites ({live}) using only your target role, level and city or country. Never your name, contact details or résumé.</li>}
      </ul>
    </section>

    <section aria-labelledby="p-server">
      <h2 id="p-server">What our server keeps</h2>
      <ul>
        <li>Today's usage counters for your device and a scrambled (hashed) version of your network address, so the free limits are fair. They expire after two days.</li>
        <li>The jobs already shown to your device, for 30 days, so you never see the same job twice.</li>
        <li>When no job fits, a count of searches per country and the target roles asked for there (no names, no devices), so Ami can look for job boards in that country.</li>
        <li>Your device's public key (not the private one, which never leaves your browser), so requests can be checked as really coming from you. It expires after 90 days unused.</li>
        <li>If you share a progress card, what you chose to show (your numbers, and your first name if you added it) is written into the card's link itself, so it isn't stored anywhere; the link is signed so nobody can change it. We count how many cards are shared and how many times card links are opened each day, as totals only.</li>
        <li>No résumés, no chat content, no cookies and no analytics.</li>
      </ul>
    </section>

    <section aria-labelledby="p-bots">
      <h2 id="p-bots">Keeping bots out</h2>
      <p>The first time a device opens Ami, Cloudflare Turnstile checks it isn't a bot. It is usually invisible. See <a href="https://www.cloudflare.com/turnstile-privacy-policy/" rel="noopener">Cloudflare's Turnstile privacy policy</a>. The only other outside request is a one-off download: the first time you answer a mock interview by speaking, the speech model (about 77 MB) downloads from <a href="https://huggingface.co/privacy" rel="noopener">Hugging Face</a>, which hosts it, and so does Ami's natural voice (about 92 MB) if you choose it; your browser keeps both. Ami's voice is made on your device too. Nothing you say or write is sent there.</p>
    </section>

    <section aria-labelledby="p-jobs">
      <h2 id="p-jobs">Where jobs come from</h2>
      <p>Only free, public sources: job feeds and company job boards collected about once an hour{live ? ', plus live searches when nothing saved fits' : ''}. Only roles from the last month are kept. New company boards are added automatically, but only from hiring systems that publish an official public job API; sites whose terms forbid automated access are never used. Every job card names its source with a link, and "Open job" goes to the page the source asks for. You apply yourself; nothing is submitted for you.</p>
      <ul class="privacy__sources">
        {SOURCES.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a>: {s.note}</li>)}
      </ul>
    </section>

    <section aria-labelledby="p-limits">
      <h2 id="p-limits">Daily limits</h2>
      <p>Per device, resetting at your midnight: {DAILY_LIMITS.messages} messages, {DAILY_LIMITS.jobs} fresh jobs, {DAILY_LIMITS.tailored} tailored résumés, {DAILY_LIMITS.letters} cover letters, {DAILY_LIMITS.guides} interview prep guides and {DAILY_LIMITS.interviews} mock interviews. There are also limits per network, and a small daily budget for the whole site: if it runs out, Ami takes a breather until tomorrow.</p>
    </section>

    <section aria-labelledby="p-delete">
      <h2 id="p-delete">Deleting everything</h2>
      <p>Open <a href="/career">Ami</a> and choose <strong>Delete everything</strong> at the bottom of the sidebar (or the sheet on a phone). It wipes your chats, résumé, documents and saved jobs at once. Today's usage limits are kept on our server, so deleting doesn't reset them. Clearing this site's data in your browser also removes this device's keys.</p>
    </section>

    <p class="privacy__note">AI suggestions can be wrong. Review everything before you send it.</p>
  </main>
  <Footer name={identity.name} email={identity.email} linkedin={identity.linkedin} instagram={identity.instagram} />
</Base>

<style>
  .privacy { display: flex; flex-direction: column; gap: var(--s-6); max-width: 760px; padding-block: var(--s-12) var(--s-16); }
  .privacy__title { font-size: var(--fs-h2); line-height: 1; letter-spacing: -0.03em; }
  .privacy__lead { margin: 0; color: var(--ink-muted); font-size: var(--fs-lead); }
  section { display: flex; flex-direction: column; gap: var(--s-3); }
  h2 { font-size: var(--fs-h3); }
  ul { display: flex; flex-direction: column; gap: var(--s-2); margin: 0; padding-left: 1.2em; }
  p { margin: 0; }
  /* Inline links keep a 44 px tap area without changing the line height. */
  main a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    margin-block: calc((var(--tap) - 1.55em) / -2);
    color: inherit;
    text-underline-offset: 3px;
  }
  /* A list of links: each row is a full tap target, so no negative margins that would overlap neighbours. */
  .privacy__sources { gap: 0; }
  .privacy__sources a { margin-block: 0; }
  .privacy__note { color: var(--ink-subtle); }
</style>
