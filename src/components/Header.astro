---
import Avatar from './Avatar.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  brand: string;
  /** Off the home page, section links point back to it. */
  home?: boolean;
}
const { brand, home = true } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);

const links = [
  { href: at('#about'), label: 'About' },
  { href: at('#journey'), label: 'Journey' },
  { href: at('#blog'), label: 'Writing' },
  { href: at('#resume'), label: 'Résumé' },
];
---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a class="brand" href={home ? '#top' : '/'}>
      <Avatar size={32} eager />
      <span class="brand__name">{brand}</span>
    </a>
    <div class="nav__track">
      <span class="nav__pill" aria-hidden="true"></span>
      <ul class="nav__links" role="list">
        {links.map((l) => <li><a class="navlink" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="nav__actions">
      <ThemeToggle />
      <button class="menu-pill" type="button" popovertarget="mobile-menu" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
        <span class="menu-pill__word">Menu</span>
      </button>
      <a class="btn btn--peach nav__cta" href={at('#contact')}>Let's talk</a>
    </div>
  </nav>
  <div class="progress" aria-hidden="true">
    <span class="progress__fill"></span>
    <span class="progress__rail"><span class="progress__dot clay-sphere clay--lilac"></span></span>
  </div>
</header>

<div id="mobile-menu" class="sheet" popover aria-label="Menu">
  <span class="sheet__handle" aria-hidden="true"></span>
  <ul class="sheet__links" role="list">
    {links.map((l) => <li><a class="sheet__link" href={l.href} data-close-menu>{l.label}</a></li>)}
  </ul>
  <a class="btn btn--peach sheet__cta" href={at('#contact')} data-close-menu>Let's talk</a>
  <button class="sheet__close" type="button" popovertarget="mobile-menu" popovertargetaction="hide">Close</button>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(8px, 2.5vw, var(--s-4));
    padding-block: 14px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration: none;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(17px, 4.6vw, 20px);
    letter-spacing: -0.02em;
  }
  .nav__track { position: relative; }
  /* Clay pill that slides (FLIP) to the link of the section in view — src/islands/header.ts. */
  .nav__pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--ledge-sm) var(--line);
    opacity: 0;
    transform-origin: left center;
    transition: opacity var(--dur-1) var(--ease-out);
  }
  .nav__pill:global(.is-on) { opacity: 1; }
  .nav__links {
    position: relative;
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
  }
  .navlink {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .navlink:hover { background: var(--surface); }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: clamp(8px, 2vw, var(--s-3));
  }

  .menu-pill {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 0;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--ledge-sm) var(--line);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-spring);
  }
  .menu-pill:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--line); }

  .progress {
    position: relative;
    height: 6px;
    /* The orb's rail is translated by its own width; keep that box from widening the page. */
    overflow-x: clip;
    background: var(--surface-alt);
  }
  .progress__fill {
    position: absolute;
    inset: 0;
    background: var(--lilac);
    transform-origin: left;
    transform: scaleX(0);
  }
  /* The rail is the track minus the dot's width, so translateX(100%) parks the dot at the far end. */
  .progress__rail {
    position: absolute;
    top: -4px;
    left: 0;
    right: 14px;
    height: 14px;
  }
  .progress__dot {
    display: block;
    width: 14px;
    height: 14px;
    font-size: 5px;
  }

  .sheet {
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: var(--s-3) var(--gutter) calc(var(--s-6) + env(safe-area-inset-bottom));
    border: 0;
    border-radius: var(--r-xl) var(--r-xl) 0 0;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 -12px 40px var(--clay-drop);
  }
  .sheet::backdrop { background: var(--clay-drop); }
  .sheet:popover-open {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .sheet__handle {
    align-self: center;
    width: 44px;
    height: 5px;
    margin-bottom: var(--s-2);
    border-radius: var(--r-pill);
    background: var(--line);
  }
  .sheet__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheet__link {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--s-2);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }
  .sheet__cta { margin-top: var(--s-2); }
  .sheet__close {
    min-height: var(--tap);
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink-muted);
    font-weight: 500;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .nav__track,
    .nav__links,
    .nav__cta { display: none; }
    .menu-pill { display: inline-flex; }
  }
  /* Below ~400px there's no room for the word: the pill becomes a 44px icon button (its aria-label stays). */
  @media (max-width: 400px) {
    .menu-pill { width: var(--tap); padding: 0; justify-content: center; }
    .menu-pill__word { display: none; }
  }
  @media (min-width: 761px) {
    .sheet { display: none; }
  }
</style>

<script>
  const sheet = document.getElementById('mobile-menu');
  sheet?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-close-menu]')) sheet.hidePopover();
  });
</script>
