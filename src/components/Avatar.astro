---
import avif from '../assets/portrait-avatar-104.avif?url';
import webp from '../assets/portrait-avatar-104.webp?url';

// Small round portrait (nav, hero badge, mode switch, résumé card, footer). Decorative: the name always sits next to it.
// One pre-built 104 px file (≈3 KB), not an Astro <Picture>: on-demand pages like /career would otherwise resize it per
// request through /_image. Sizes are classes, not inline styles, so it renders under /career's strict CSP.
type Size = 22 | 30 | 32 | 36 | 52;
interface Props {
  size: Size;
  class?: string;
  /** Above the fold (nav, hero): load straight away. */
  eager?: boolean;
}
const { size, class: className, eager = false } = Astro.props;
---

<span class:list={['avatar', `avatar--${size}`, className]} aria-hidden="true">
  <picture>
    <source srcset={avif} type="image/avif" />
    <img src={webp} width={size} height={size} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </picture>
</span>

<style>
  .avatar {
    display: block;
    flex: none;
    width: var(--av);
    height: var(--av);
    overflow: hidden;
    border-radius: 50%;
    background: var(--lilac);
  }
  .avatar--22 { --av: 22px; }
  .avatar--30 { --av: 30px; }
  .avatar--32 { --av: 32px; }
  .avatar--36 { --av: 36px; }
  .avatar--52 { --av: 52px; }
  .avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
