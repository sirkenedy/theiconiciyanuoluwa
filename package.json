{
  "name": "theiconiciyanuoluwa",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "resume": "node scripts/build-resume.ts",
    "dev": "npm run resume && astro dev",
    "build": "npm run resume && npm run check:content && astro build && node scripts/check-content.ts --dist",
    "check:content": "node scripts/check-content.ts",
    "preview": "node scripts/serve-static.mjs",
    "check": "astro check && node scripts/lint-tokens.mjs",
    "size": "node scripts/size-report.mjs",
    "lh": "node scripts/lighthouse.mjs",
    "test:a11y": "playwright test",
    "perf:scroll": "node scripts/scroll-perf.mjs",
    "test:api": "node --test tests/react-api.test.ts tests/twin-api.test.ts tests/career-api.test.ts tests/career-ai.test.ts tests/jobs.test.ts tests/tailor.test.ts tests/career-limits.test.ts tests/job-search.test.ts tests/prep-guide.test.ts tests/interview.test.ts",
    "test:unit": "node --test tests/geo.test.ts tests/twin-unit.test.ts tests/voice.test.ts tests/card.test.ts",
    "test:twin": "node tests/twin.eval.ts",
    "test:career-eval": "node tests/career.eval.ts",
    "reset:local-usage": "node scripts/reset-local-usage.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@astrojs/preact": "4.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "9.0.5",
    "@huggingface/transformers": "4.3.1",
    "astro": "5.18.2",
    "docx": "9.12.0",
    "dompurify": "3.4.17",
    "kokoro-js": "1.2.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "lighthouse": "13.6.0",
    "satori": "0.63.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
